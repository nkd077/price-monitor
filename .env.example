# --- Уведомления в Telegram (необязательно)
# Токен бота от @BotFather и чат, куда слать уведомления (свой ID можно узнать у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Уведомлять, если цена упала хотя бы на столько процентов
DROP_ALERT_PERCENT=5

# --- Google Таблица (необязательно)
# ID таблицы из её адреса: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# JSON-ключ сервисного аккаунта; дайте его e-mail права редактора таблицы
GOOGLE_CREDENTIALS_FILE=

# --- Бережная загрузка сайтов
CONCURRENCY=5
PER_HOST_DELAY=1.5
REQUEST_TIMEOUT=20
MAX_RETRIES=3
RESPECT_ROBOTS=true

# DB_PATH=data/prices.db
# PRODUCTS_FILE=products.json
